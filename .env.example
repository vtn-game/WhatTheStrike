# WhatTheStrike 環境設定
# このファイルをコピーして .env として保存し、各自の環境に合わせて編集してください

# Unity Editor のパス（バージョンに合わせて変更）
# Windows の例:
UNITY_EDITOR_PATH=C:\Program Files\Unity\Hub\Editor\6000.3.2f1\Editor\Unity.exe

# Mac の例:
# UNITY_EDITOR_PATH=/Applications/Unity/Hub/Editor/6000.3.2f1/Unity.app/Contents/MacOS/Unity

# Linux の例:
# UNITY_EDITOR_PATH=/home/user/Unity/Hub/Editor/6000.3.2f1/Editor/Unity

# GitHub リポジトリ情報（gh cliを使用する場合は不要）
# GITHUB_OWNER=vtn-game
# GITHUB_REPO=WhatTheStrike
